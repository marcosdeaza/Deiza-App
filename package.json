{
  "name": "deiza-desktop",
  "productName": "Deiza",
  "version": "1.1.6",
  "description": "Deiza para escritorio: el workspace completo y Deiza Code en una sola app.",
  "main": "src/main/main.js",
  "author": "Deiza Solutions <contact@deiza.org>",
  "homepage": "https://deiza.org/desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "sync-engine": "node scripts/sync-engine.js",
    "vendor": "node scripts/vendor-assets.js",
    "icons": "node scripts/make-icons.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist": "electron-builder --mac --win --linux --publish never",
    "release": "bash scripts/release.sh",
    "dist:store": "node scripts/build-store.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "dompurify": "^3.4.15",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "highlight.js": "11.12.0",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "org.deiza.desktop",
    "productName": "Deiza",
    "copyright": "Copyright © 2026 Deiza Solutions",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!test/**"
    ],
    "asar": true,
    "asarUnpack": [],
    "protocols": [
      {
        "name": "Deiza",
        "schemes": [
          "deiza"
        ]
      }
    ],
    "artifactName": "Deiza-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Deiza usa el micrófono para dictar mensajes por voz.",
        "NSAppleEventsUsageDescription": "Deiza Code puede abrir archivos y carpetas de tus proyectos.",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "Deiza",
      "icon": "build/icon.icns",
      "background": "build/background.tiff",
      "iconSize": 104,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 184
        },
        {
          "x": 480,
          "y": 184,
          "type": "link",
          "path": "/Applications",
          "name": "Aplicaciones"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deiza",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Deiza",
      "language": "3082",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "afterPack": "build/after-pack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
